<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Login" scope="request"/>
<!DOCTYPE html><html lang="en"><head><%@ include file="../common/head.jsp" %><link rel="stylesheet" href="${pageContext.request.contextPath}/css/modules/auth.css"></head>
<body class="drivehub auth-page login-page" data-context="${pageContext.request.contextPath}" data-page="login">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%-- FRONTEND MOCK DATA: replace with backend model/JSTL later --%>
<main class="auth-scene" id="main-content"><a class="auth-brand" href="${pageContext.request.contextPath}/login"><span class="brand-mark"><i class="bi bi-car-front-fill" aria-hidden="true"></i></span><span><strong>DriveHub</strong><small>Vehicle Rental Service</small></span></a><div class="auth-intro"><h1>Your Journey<br>Starts Here</h1><p>Rent vehicles, manage your fleet, and explore<br>new destinations with DriveHub.</p></div><section class="auth-card"><header><h2>Welcome Back</h2><p>Sign in to your DriveHub account</p></header><form onsubmit="return false;" id="login-form"><div class="form-group"><label class="sr-only" for="login-email">Email address</label><div class="password-control"><i class="bi bi-envelope" aria-hidden="true"></i><input class="form-control" id="login-email" type="email" autocomplete="email" placeholder="Email address" required></div></div><div class="form-group"><label class="sr-only" for="login-password">Password</label><div class="password-control"><i class="bi bi-lock" aria-hidden="true"></i><input class="form-control" type="password" id="login-password" name="login-password" required minlength="6" autocomplete="current-password" placeholder="Password"><button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div><div class="remember-row"><label class="check-row"><input type="checkbox" id="remember-me" checked> Remember me</label><button type="button" class="btn text-link" data-forgot-password>Forgot password?</button></div><button class="btn btn-primary auth-submit" type="submit">Login <i class="bi bi-arrow-right" aria-hidden="true"></i></button></form><div class="auth-divider">Or continue with</div><div class="login-roles"><a class="login-role customer" href="${pageContext.request.contextPath}/customer/dashboard" aria-label="Preview as Customer"><i class="bi bi-person-fill" aria-hidden="true"></i><span>Login as<br><strong>Customer</strong></span></a><a class="login-role owner" href="${pageContext.request.contextPath}/owner/dashboard" aria-label="Preview as Vehicle Owner"><i class="bi bi-car-front-fill" aria-hidden="true"></i><span>Login as<br><strong>Vehicle Owner</strong></span></a><a class="login-role admin" href="${pageContext.request.contextPath}/admin/dashboard" aria-label="Preview as Admin"><i class="bi bi-shield-fill-check" aria-hidden="true"></i><span>Login as<br><strong>Admin</strong></span></a></div><p class="auth-register">Don't have an account? <a href="${pageContext.request.contextPath}/register">Register Now</a></p></section><section class="auth-benefits" aria-label="DriveHub benefits"><article><i class="bi bi-car-front" aria-hidden="true"></i><h3>Wide Vehicle Selection</h3><p>Cars, Vans, SUVs, Motorcycles<br>and more</p></article><article><i class="bi bi-shield-check" aria-hidden="true"></i><h3>Safe &amp; Reliable</h3><p>Verified vehicles and<br>secure bookings</p></article><article><i class="bi bi-geo-alt" aria-hidden="true"></i><h3>Multiple Locations</h3><p>Convenient branches<br>across Sri Lanka</p></article></section><a class="auth-guide-link" href="${pageContext.request.contextPath}/instructions"><i class="bi bi-book" aria-hidden="true"></i> New to DriveHub? Read the user guide</a></main>
<%@ include file="../common/messages.jsp" %>
</body></html>
