<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Register" scope="request"/>
<!DOCTYPE html><html lang="en"><head><%@ include file="../common/head.jsp" %><link rel="stylesheet" href="${pageContext.request.contextPath}/css/modules/auth.css"></head>
<body class="drivehub auth-page register-page" data-context="${pageContext.request.contextPath}" data-page="register">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%-- FRONTEND MOCK DATA: replace with backend model/JSTL later --%>
<main class="auth-scene register-scene" id="main-content"><a class="auth-brand" href="${pageContext.request.contextPath}/login"><span class="brand-mark"><i class="bi bi-car-front-fill" aria-hidden="true"></i></span><span><strong>DriveHub</strong><small>Vehicle Rental Service</small></span></a><div class="auth-intro"><h1>Your Journey<br>Starts Here</h1><p>Join DriveHub and find your next adventure.</p></div><section class="auth-card register-card"><header><h2>Create Your Account</h2><p>Get started with DriveHub</p></header><form onsubmit="return false;" id="register-form"><div class="form-grid"><div class="form-group"><label for="register-name">Full Name <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="register-name" name="register-name" type="text" value="" required autocomplete="name" placeholder="Your full name"></div><div class="form-group"><label for="register-email">Email Address <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="register-email" name="register-email" type="email" value="" required autocomplete="email" placeholder="you@example.com"></div><div class="form-group"><label for="register-phone">Phone Number <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="register-phone" name="register-phone" type="tel" value="" required autocomplete="tel" placeholder="+94 77 123 4567"></div><div class="form-group"><label for="account-type">Account Type <span class="required">*</span></label><select class="form-select" id="account-type" name="account-type" required><option value="customer">Customer</option><option value="owner">Vehicle Owner</option></select></div><div class="form-group"><label class="" for="register-password">Password *</label><div class="password-control"><i class="bi bi-lock" aria-hidden="true"></i><input class="form-control" type="password" id="register-password" name="register-password" required minlength="6" autocomplete="new-password" placeholder="At least 6 characters"><button class="password-toggle" type="button" data-password-toggle="register-password" aria-label="Show password *" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div><div class="form-group"><label class="" for="confirm-password">Confirm Password *</label><div class="password-control"><i class="bi bi-lock" aria-hidden="true"></i><input class="form-control" type="password" id="confirm-password" name="confirm-password" required minlength="6" autocomplete="new-password" placeholder="Re-enter password"><button class="password-toggle" type="button" data-password-toggle="confirm-password" aria-label="Show confirm password *" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div></div><label class="check-row"><input type="checkbox" required id="register-terms"> I agree to the <button class="text-link" type="button" data-terms>Terms &amp; Conditions</button></label><p class="form-error" id="register-error" role="alert"></p><button class="btn btn-primary auth-submit" type="submit">Register <i class="bi bi-arrow-right" aria-hidden="true"></i></button></form><p class="auth-register">Already have an account? <a href="${pageContext.request.contextPath}/login">Back to Login</a></p></section><section class="auth-benefits" aria-label="DriveHub benefits"><article><i class="bi bi-car-front" aria-hidden="true"></i><h3>Wide Vehicle Selection</h3><p>Cars, Vans, SUVs, Motorcycles<br>and more</p></article><article><i class="bi bi-shield-check" aria-hidden="true"></i><h3>Safe &amp; Reliable</h3><p>Verified vehicles and<br>secure bookings</p></article><article><i class="bi bi-geo-alt" aria-hidden="true"></i><h3>Multiple Locations</h3><p>Convenient branches<br>across Sri Lanka</p></article></section></main>
<%@ include file="../common/messages.jsp" %>
</body></html>
