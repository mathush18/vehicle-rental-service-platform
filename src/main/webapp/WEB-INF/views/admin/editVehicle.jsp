<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="uiRole" value="admin" scope="request"/>
<c:set var="pageTitle" value="Edit Vehicle" scope="request"/>
<c:set var="navKey" value="vehicles" scope="request"/>
<!DOCTYPE html>
<html lang="en"><head><%@ include file="../common/head.jsp" %></head>
<body class="drivehub role-admin" data-role="admin" data-context="${pageContext.request.contextPath}" data-page="editVehicle">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%@ include file="../common/sidebar.jsp" %>
<%@ include file="../common/navbar.jsp" %>
<main class="app-main page-content" id="main-content">
<%-- FRONTEND MOCK DATA: replace with backend model/JSTL later --%>
<header class="page-header"><div class="page-heading"><i class="bi bi-car-front-fill" aria-hidden="true"></i><div><h1>Edit Vehicle</h1><p>Update the vehicle information.</p></div></div></header><form onsubmit="return false;" data-vehicle-form data-preview-form class="vehicle-form-layout" data-edit="true"><section class="content-card"><h2>Vehicle Information</h2><div class="form-grid"><div class="form-group"><label for="brand">Brand <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="brand" name="brand" type="text" value="Toyota" required placeholder="e.g. Toyota" maxlength="50"></div><div class="form-group"><label for="model">Model <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="model" name="model" type="text" value="Corolla" required placeholder="e.g. Corolla" maxlength="50"></div><div class="form-group"><label for="type">Vehicle Type <span class="required">*</span></label><select class="form-select" id="type" name="type" required><option value="">Select type</option><option>Car</option><option>Van</option><option>Motorcycle</option><option>SUV</option></select></div><div class="form-group"><label for="price">Price Per Day (Rs.) <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="price" name="price" type="number" value="8000" required min="1" max="1000000" step="1" placeholder="e.g. 8000"></div><div class="form-group"><label for="branch">Branch <span class="required">*</span></label><select class="form-select" id="branch" name="branch" required><option value="">Select branch</option><option>Colombo Branch</option><option>Kandy Branch</option><option>Galle Branch</option><option>Jaffna Branch</option><option>Matara Branch</option></select></div><div class="form-group"><label for="availability">Availability <span class="required">*</span></label><select class="form-select" id="availability" name="availability" ><option>Available</option><option>Rented</option><option>Unavailable</option></select></div></div><div class="form-group upload-group"><label for="vehicle-image">Current Image</label><input type="file" class="sr-only" id="vehicle-image" accept="image/jpeg,image/png,image/webp" data-image-input><div class="current-image"><div data-upload-preview><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" ></div></div><label class="btn btn-secondary" for="vehicle-image"><i class="bi bi-image" aria-hidden="true"></i> Change Image</label><button type="button" class="btn btn-danger-soft" data-remove-image><i class="bi bi-trash" aria-hidden="true"></i> Remove</button></div><p class="small-text" data-image-feedback aria-live="polite"></p></div><div class="form-actions"><a class="btn btn-muted" href="${pageContext.request.contextPath}/admin/vehicles" >Cancel</a><button class="btn btn-primary" type="submit"><i class="bi bi-save" aria-hidden="true"></i> Update Vehicle</button></div></section><aside class="content-card vehicle-preview"><h2>Preview</h2><div data-upload-preview><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" ></div></div><div class="section-header"><h3 data-preview-name>Toyota Corolla</h3><span class="badge badge-success" data-status-label>Available</span></div><p data-preview-type>Car</p><p><strong>Rs. <span data-preview-price>8,000</span></strong> / day</p><p class="small-text"><i class="bi bi-geo-alt" aria-hidden="true"></i> <span data-preview-branch>Colombo Branch</span></p></aside></form>
</main>
<%@ include file="../common/footer.jsp" %>
<%@ include file="../common/messages.jsp" %>
</body></html>
