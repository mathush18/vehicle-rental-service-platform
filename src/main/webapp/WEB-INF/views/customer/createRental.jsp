<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="uiRole" value="customer" scope="request"/>
<c:set var="pageTitle" value="Create Rental" scope="request"/>
<c:set var="navKey" value="rentals" scope="request"/>
<!DOCTYPE html>
<html lang="en"><head><%@ include file="../common/head.jsp" %></head>
<body class="drivehub role-customer" data-role="customer" data-context="${pageContext.request.contextPath}" data-page="createRental">
<a class="skip-link" href="#main-content">Skip to main content</a>
<%@ include file="../common/sidebar.jsp" %>
<%@ include file="../common/navbar.jsp" %>
<main class="app-main page-content" id="main-content">
<%-- FRONTEND MOCK DATA: replace with backend model/JSTL later --%>
<a class="back-link" href="${pageContext.request.contextPath}/customer/vehicles/details?id=1" data-back-vehicle><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Vehicle Details</a>
<ol class="stepper" aria-label="Booking progress"><li class="active" data-step-marker="1" aria-current="step"><span>1</span> Rental Details</li><li data-step-marker="2"><span>2</span> Customer Details</li><li data-step-marker="3"><span>3</span> Confirmation</li></ol>
<form onsubmit="return false;" class="booking-layout" id="rental-form"><section class="content-card"><div data-booking-step="1"><h2>Selected Vehicle</h2><div class="selected-vehicle"><div data-selected-photo><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" ></div></div><div><h3 data-vehicle-name>Toyota Corolla</h3><p data-vehicle-type>Car</p><p class="vehicle-price"><strong>Rs. <span data-vehicle-price>8,000</span></strong> / day</p><p class="small-text"><i class="bi bi-geo-alt" aria-hidden="true"></i> <span data-vehicle-branch>Colombo Branch</span></p></div></div><h2>Rental Information</h2><div class="form-grid"><div class="form-group"><label for="pickup-date">Pick-up Date <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="pickup-date" name="pickup-date" type="date" value="2026-10-18" required ></div><div class="form-group"><label for="pickup-time">Pick-up Time</label><select class="form-select" id="pickup-time" name="pickup-time" ><option>10:00</option><option>09:00</option><option>11:00</option><option>12:00</option><option>14:00</option><option>16:00</option></select></div><div class="form-group"><label for="return-date">Return Date <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="return-date" name="return-date" type="date" value="2026-10-21" required ></div><div class="form-group"><label for="return-time">Return Time</label><select class="form-select" id="return-time" name="return-time" ><option>10:00</option><option>09:00</option><option>11:00</option><option>12:00</option><option>14:00</option><option>16:00</option></select></div><div class="span-2"><div class="form-group"><label for="pickup-location">Pick-up Location</label><select class="form-select" id="pickup-location" name="pickup-location" ><option>Colombo Branch</option><option>Kandy Branch</option><option>Galle Branch</option><option>Jaffna Branch</option></select></div></div></div><p class="form-error" id="rental-error" role="alert"></p></div>
<div data-booking-step="2" hidden><h2>Customer Details</h2><p class="section-description">Check your contact information for this rental.</p><div class="form-grid"><div class="form-group"><label for="renter-name">Full Name <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="renter-name" name="renter-name" type="text" value="Mathushalini.T" required autocomplete="name"></div><div class="form-group"><label for="renter-email">Email Address <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="renter-email" name="renter-email" type="email" value="mathushalini@example.com" required autocomplete="email"></div><div class="form-group"><label for="renter-phone">Phone Number <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="renter-phone" name="renter-phone" type="tel" value="+94 77 123 4567" required autocomplete="tel"></div><div class="form-group"><label for="renter-license">Driving Licence / ID <span class="required" aria-hidden="true">*</span></label><input class="form-control" id="renter-license" name="renter-license" type="text" value="" required placeholder="Enter your document number"></div></div><label class="check-row"><input type="checkbox" id="booking-terms" required> I agree to the rental terms and vehicle return policy.</label></div>
<div data-booking-step="3" hidden><h2>Review Your Request</h2><p class="section-description">Check your rental details before submitting.</p><dl class="info-list" id="booking-review"></dl><p class="preview-note">This is a frontend preview. No rental will be saved or charged.</p></div></section>
<aside><section class="content-card rental-summary"><h2>Rental Summary</h2><div class="summary-line"><span>Rs. <span data-vehicle-price>8,000</span> × <span id="rental-days">3</span> days</span><strong id="rental-subtotal">Rs. 24,000</strong></div><div class="summary-line"><label class="check-row"><input type="checkbox" id="insurance" checked> Insurance (Optional)</label><span id="insurance-price">Rs. 2,000</span></div><div class="summary-line total-line"><strong>Total Amount</strong><strong id="rental-total">Rs. 26,000</strong></div></section><div class="booking-actions"><button type="button" class="btn btn-secondary" id="booking-back" hidden><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button><button class="btn btn-primary" type="submit" id="booking-next">Next: Customer Details <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div></aside></form>
</main>
<%@ include file="../common/footer.jsp" %>
<%@ include file="../common/messages.jsp" %>
</body></html>
