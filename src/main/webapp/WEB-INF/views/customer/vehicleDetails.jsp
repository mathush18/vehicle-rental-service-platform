<a class="back-link" href="${pageContext.request.contextPath}/customer/vehicles"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Vehicles</a><section class="content-card vehicle-detail" data-vehicle-details><div class="vehicle-detail-top"><div class="gallery"><div data-main-photo><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" ></div></div><div class="thumbnails"><button type="button" class="btn thumbnail selected" data-thumbnail="1" aria-label="Full vehicle view" aria-pressed="true"><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" data-gallery-photo="1"></div></button><button type="button" class="btn thumbnail " data-thumbnail="2" aria-label="Closer vehicle view" aria-pressed="false"><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" data-gallery-photo="2"></div></button><button type="button" class="btn thumbnail " data-thumbnail="3" aria-label="Front detail" aria-pressed="false"><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" data-gallery-photo="3"></div></button><button type="button" class="btn thumbnail " data-thumbnail="4" aria-label="Wheel detail" aria-pressed="false"><div class="fleet-photo photo-1" role="img" aria-label="Toyota Corolla" data-gallery-photo="4"></div></button></div></div><div class="vehicle-summary"><div class="section-header"><h1 data-vehicle-name>Toyota Corolla</h1><span class="badge badge-success" data-status-label>Available</span></div><p data-vehicle-type>Car</p><p class="price-large"><strong>Rs. <span data-vehicle-price>8,000</span></strong> / day</p><p class="small-text"><i class="bi bi-geo-alt" aria-hidden="true"></i> <span data-vehicle-branch>Colombo Branch</span></p><p class="rating"><i class="bi bi-star-fill" aria-hidden="true"></i> <span data-vehicle-rating>4.8 (120 reviews)</span></p><a class="btn btn-primary" href="${pageContext.request.contextPath}/customer/rentals/create?id=1" data-rent-link>Rent This Vehicle</a></div></div></section><section class="details-information"><article class="content-card"><h2>Vehicle Information</h2><dl class="info-list spec-grid"><div><dt>Brand</dt><dd><span data-vehicle-brand>Toyota</span></dd></div><div><dt>Transmission</dt><dd><span data-vehicle-transmission>Automatic</span></dd></div><div><dt>Model</dt><dd><span data-vehicle-model>Corolla</span></dd></div><div><dt>Fuel Type</dt><dd>Petrol</dd></div><div><dt>Type</dt><dd><span data-vehicle-type>Car</span></dd></div><div><dt>Seating Capacity</dt><dd><span data-vehicle-seats>5</span></dd></div><div><dt>Year</dt><dd>2023</dd></div><div><dt>Availability</dt><dd>Available</dd></div></dl></article><article class="content-card branch-information"><h2>Branch Information</h2><p><i class="bi bi-geo-alt" aria-hidden="true"></i> <strong data-vehicle-branch>Colombo Branch</strong></p><p class="small-text" data-branch-address>123 Main Street, Colombo 03</p><p><i class="bi bi-telephone" aria-hidden="true"></i> <span data-branch-phone>+94 11 234 5678</span></p><a class="btn btn-secondary" href="https://www.google.com/maps/search/?api=1&amp;query=Colombo+Sri+Lanka" target="_blank" rel="noopener noreferrer" data-map-link>View on Map <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></article></section><section class="content-card"><h2>Description</h2><p data-vehicle-description>The Toyota Corolla offers a comfortable and smooth driving experience. Perfect for city travel and long trips with excellent fuel efficiency, modern features, and advanced safety systems.</p><div class="vehicle-features"><span><i class="bi bi-snow" aria-hidden="true"></i> Air Conditioning</span><span><i class="bi bi-bluetooth" aria-hidden="true"></i> Bluetooth</span><span><i class="bi bi-geo-alt" aria-hidden="true"></i> GPS Navigation</span><span><i class="bi bi-usb-symbol" aria-hidden="true"></i> USB Charging</span><span><i class="bi bi-camera" aria-hidden="true"></i> Backup Camera</span></div></section>
